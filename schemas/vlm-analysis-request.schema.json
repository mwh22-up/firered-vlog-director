{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/vlm-analysis-request.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "project_id", "media", "provider", "prompt_sha256", "shots", "safety"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "vlm-analysis-request-v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "media": { "$ref": "#/$defs/media" },
    "provider": { "$ref": "#/$defs/provider" },
    "prompt_sha256": { "$ref": "#/$defs/sha" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "start_sec", "end_sec", "evidence_ids"],
        "properties": {
          "shot_id": { "type": "string", "minLength": 1 },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "exclusiveMinimum": 0 },
          "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "media": {
      "type": "object",
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": ["name", "model", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["may_approve_deletion", "may_approve_release"],
      "properties": {
        "may_approve_deletion": { "const": false },
        "may_approve_release": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
