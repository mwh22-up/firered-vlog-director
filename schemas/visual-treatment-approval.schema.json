{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://firered.local/schemas/visual-treatment-approval.schema.json", "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "edit_plan_version", "plan_sha256", "treatment_payload_sha256", "preview_manifest_sha256", "visual_qa_sha256", "human_review_sha256", "base_media_sha256", "accepted_proposal_ids", "approved_by", "approved_at", "approval_sha256"],
  "properties": { "schema_version": { "const": "1.0" }, "contract_version": { "const": "visual-treatment-approval-v1" }, "status": { "const": "approved" }, "project_id": { "type": "string", "minLength": 1 }, "edit_plan_version": { "type": "integer", "minimum": 1 }, "plan_sha256": { "$ref": "#/$defs/sha" }, "treatment_payload_sha256": { "$ref": "#/$defs/sha" }, "preview_manifest_sha256": { "$ref": "#/$defs/sha" }, "visual_qa_sha256": { "$ref": "#/$defs/sha" }, "human_review_sha256": { "$ref": "#/$defs/sha" }, "base_media_sha256": { "$ref": "#/$defs/sha" }, "accepted_proposal_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" }, "approval_sha256": { "$ref": "#/$defs/sha" } },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": false
}
