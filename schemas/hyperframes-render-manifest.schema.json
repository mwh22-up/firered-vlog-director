{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/hyperframes-render-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "edit_plan_version", "edit_plan_sha256", "effect_plan", "effect_plan_sha256", "effect_payload_sha256", "composition_manifest", "composition_manifest_sha256", "hyperframes", "effects"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "hyperframes-render-manifest-v1" },
    "status": { "const": "rendered" },
    "project_id": { "type": "string", "minLength": 1 },
    "edit_plan_version": { "type": "integer", "minimum": 1 },
    "edit_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_plan": { "$ref": "#/$defs/path" },
    "effect_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_payload_sha256": { "$ref": "#/$defs/sha" },
    "composition_manifest": { "$ref": "#/$defs/path" },
    "composition_manifest_sha256": { "$ref": "#/$defs/sha" },
    "hyperframes": {
      "type": "object",
      "required": ["executable", "package", "version", "npm_integrity"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "package": { "const": "hyperframes" },
        "version": { "const": "0.7.90" },
        "npm_integrity": { "type": "string", "pattern": "^sha512-" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effect_id", "intent", "duration_sec", "composition", "composition_sha256", "output", "output_size_bytes", "output_sha256"],
        "properties": {
          "effect_id": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
          "composition": { "$ref": "#/$defs/path" },
          "composition_sha256": { "$ref": "#/$defs/sha" },
          "output": { "$ref": "#/$defs/path" },
          "output_size_bytes": { "type": "integer", "minimum": 1 },
          "output_sha256": { "$ref": "#/$defs/sha" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^work/effects/[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  },
  "additionalProperties": false
}
