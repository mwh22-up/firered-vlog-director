{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/hyperframes-composition-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "edit_plan_version", "edit_plan_sha256", "edit_plan_file", "effect_plan", "effect_plan_sha256", "effect_payload_sha256", "job_directory", "canvas", "hyperframes", "effects"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "hyperframes-composition-manifest-v1" },
    "status": { "const": "composed" },
    "project_id": { "type": "string", "minLength": 1 },
    "edit_plan_version": { "type": "integer", "minimum": 1 },
    "edit_plan_sha256": { "$ref": "#/$defs/sha" },
    "edit_plan_file": { "$ref": "#/$defs/path" },
    "effect_plan": { "$ref": "#/$defs/path" },
    "effect_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_payload_sha256": { "$ref": "#/$defs/sha" },
    "job_directory": { "type": "string", "pattern": "^work/effects/[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "const": 30 }
      },
      "additionalProperties": false
    },
    "hyperframes": { "$ref": "#/$defs/hyperframes" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/effect" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^work/(?:plans|effects)/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "hyperframes": {
      "type": "object",
      "required": ["package", "version", "npm_integrity"],
      "properties": {
        "package": { "const": "hyperframes" },
        "version": { "const": "0.7.90" },
        "npm_integrity": { "type": "string", "pattern": "^sha512-" }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["effect_id", "intent", "duration_sec", "composition", "composition_sha256", "output"],
      "properties": {
        "effect_id": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "composition": { "$ref": "#/$defs/path" },
        "composition_sha256": { "$ref": "#/$defs/sha" },
        "output": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
