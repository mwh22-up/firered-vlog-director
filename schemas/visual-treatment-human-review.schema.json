{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://firered.local/schemas/visual-treatment-human-review.schema.json", "type": "object",
  "required": ["schema_version", "contract_version", "status", "reviewer", "reviewed_at", "plan_sha256", "treatment_payload_sha256", "preview_manifest_sha256", "visual_qa_sha256", "base_media_sha256", "proposals", "attestation"],
  "properties": { "schema_version": { "const": "1.0" }, "contract_version": { "const": "visual-treatment-human-review-v1" }, "status": { "const": "approved" }, "reviewer": { "type": "string", "minLength": 1 }, "reviewed_at": { "type": "string", "format": "date-time" }, "plan_sha256": { "$ref": "#/$defs/sha" }, "treatment_payload_sha256": { "$ref": "#/$defs/sha" }, "preview_manifest_sha256": { "$ref": "#/$defs/sha" }, "visual_qa_sha256": { "$ref": "#/$defs/sha" }, "base_media_sha256": { "$ref": "#/$defs/sha" }, "proposals": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["proposal_id", "decision", "checks"], "properties": { "proposal_id": { "type": "string", "minLength": 1 }, "decision": { "enum": ["accepted", "rejected"] }, "checks": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["exposure", "color", "detail", "composition"] } }, "notes": { "type": "string", "maxLength": 1000 } }, "additionalProperties": false } }, "attestation": { "const": "I reviewed every before/after visual treatment preview." } },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": false
}
