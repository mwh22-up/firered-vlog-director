{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/subtitle-approval.schema.json",
  "title": "Subtitle Approval",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "approval_version",
    "status",
    "project_id",
    "review_source_sha256",
    "subtitle_payload_sha256",
    "subtitle_style_sha256",
    "verified_cue_set_sha256",
    "readability_qa_sha256",
    "layout_qa_sha256",
    "visual_qa_sha256",
    "human_review_sha256",
    "realized_timeline_sha256",
    "readability_policy_version",
    "layout_probe_version",
    "visual_qa_version",
    "cue_ids",
    "approved_by",
    "approved_at",
    "human_review_approved_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "document_type": { "const": "subtitle_approval" },
    "approval_version": { "const": "subtitle-approval-v1" },
    "status": { "const": "approved" },
    "project_id": { "type": "string", "minLength": 1 },
    "review_source_sha256": { "$ref": "#/$defs/sha256" },
    "subtitle_payload_sha256": { "$ref": "#/$defs/sha256" },
    "subtitle_style_sha256": { "$ref": "#/$defs/sha256" },
    "verified_cue_set_sha256": { "$ref": "#/$defs/sha256" },
    "readability_qa_sha256": { "$ref": "#/$defs/sha256" },
    "layout_qa_sha256": { "$ref": "#/$defs/sha256" },
    "visual_qa_sha256": { "$ref": "#/$defs/sha256" },
    "human_review_sha256": { "$ref": "#/$defs/sha256" },
    "realized_timeline_sha256": { "$ref": "#/$defs/sha256" },
    "readability_policy_version": { "type": "string", "minLength": 1 },
    "layout_probe_version": { "type": "string", "minLength": 1 },
    "visual_qa_version": { "type": "string", "minLength": 1 },
    "cue_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "minLength": 1 },
    "human_review_approved_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
