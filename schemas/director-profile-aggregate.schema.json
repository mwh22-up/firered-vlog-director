{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/director-profile-aggregate.schema.json",
  "title": "Aggregated Reference Director Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "source_count",
    "reference_sources",
    "shared_rules",
    "semantic_principles",
    "shot_selection_model",
    "pacing_model",
    "audio_model",
    "source_variants",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string" },
    "source_count": { "type": "integer", "minimum": 1 },
    "reference_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "shared_rules": { "type": "array" },
    "semantic_principles": { "type": "array" },
    "shot_selection_model": {
      "type": "object",
      "required": [
        "retain_archetypes",
        "cut_first_signals",
        "sequence_dependencies"
      ]
    },
    "pacing_model": { "type": "object" },
    "audio_model": { "type": "object" },
    "source_variants": { "type": "array" },
    "limitations": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
