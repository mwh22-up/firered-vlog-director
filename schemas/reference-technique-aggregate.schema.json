{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/reference-technique-aggregate.schema.json",
  "title": "Aggregated Reference Techniques",
  "$defs": {
    "evidence_range": {
      "type": "object",
      "required": ["source_id", "start_sec", "end_sec", "observation_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "start_sec": { "type": "number", "minimum": 0 },
        "end_sec": { "type": "number", "exclusiveMinimum": 0 },
        "observation_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "guardrail_variant": {
      "type": "object",
      "required": ["source_id", "observation_id", "guardrails"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "observation_id": { "type": "string", "minLength": 1 },
        "guardrails": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "parameter_variant": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "pattern": {
      "type": "object",
      "required": [
        "technique_key",
        "category",
        "source_support",
        "source_ids",
        "average_confidence",
        "trigger_examples",
        "treatment_examples",
        "parameter_variants",
        "guardrail_variants",
        "evidence_ranges"
      ],
      "properties": {
        "technique_key": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "opening_montage",
            "music_rhythm",
            "scenic",
            "narrative",
            "subtitle",
            "graphic",
            "humor",
            "playback_rate",
            "sound_effect"
          ]
        },
        "source_support": { "type": "integer", "minimum": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "average_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "trigger_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "treatment_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "parameter_variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter_variant" }
        },
        "guardrail_variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/guardrail_variant" }
        },
        "evidence_ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_range" }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "source_count",
    "source_ids",
    "minimum_source_support",
    "stable_patterns",
    "source_specific_patterns",
    "model_context_policy",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "source_count": { "type": "integer", "minimum": 1 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "minimum_source_support": { "type": "integer", "minimum": 1 },
    "stable_patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    },
    "source_specific_patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    },
    "opening_recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "model_context_policy": {
      "type": "object",
      "required": [
        "default_maximum_characters",
        "hard_limit_characters",
        "comparison"
      ],
      "properties": {
        "default_maximum_characters": { "type": "integer", "minimum": 1 },
        "hard_limit_characters": { "type": "integer", "minimum": 2 },
        "comparison": { "const": "strictly_less_than" }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
