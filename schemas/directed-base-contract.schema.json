{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/directed-base-contract.schema.json",
  "title": "Directed Base Media Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "status",
    "project_id",
    "edit_plan",
    "approval",
    "realized_timeline",
    "base_media",
    "producer",
    "ffmpeg_identity"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "directed-base-contract-v1" },
    "status": { "const": "ready" },
    "project_id": { "type": "string", "minLength": 1 },
    "edit_plan": { "$ref": "#/$defs/binding" },
    "approval": { "$ref": "#/$defs/binding" },
    "realized_timeline": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "type": "object",
          "required": ["duration_sec"],
          "properties": {
            "duration_sec": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "base_media": {
      "type": "object",
      "required": ["name", "sha256", "size_bytes", "duration_sec", "width", "height", "has_video", "has_audio"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "has_video": { "const": true },
        "has_audio": { "const": true }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["repository", "commit_sha", "contract"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contract": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ffmpeg_identity": {
      "type": "object",
      "required": ["executable_sha256", "version_line"],
      "properties": {
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "version_line": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^work/(?:plans|qa)/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
