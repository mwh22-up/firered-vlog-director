{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/enhancement-plan.schema.json",
  "title": "Vlog Enhancement Plan",
  "type": "object",
  "$defs": {
    "subtitleEvidenceBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))work/qa/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "effectEvidenceBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^work/(?:effects|qa/effects)/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "version",
    "edit_plan_version",
    "timeline_duration_sec",
    "render_stages",
    "video_treatments",
    "music",
    "subtitles",
    "illustration_motion"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "edit_plan_version": { "type": "integer", "minimum": 1 },
    "timeline_duration_sec": { "type": "number", "minimum": 0 },
    "render_stages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 7,
      "maxItems": 7
    },
    "video_treatments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "stabilization", "continuity", "audio"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "stabilization": {
            "type": "object",
            "required": ["mode", "strength", "max_crop_percent"],
            "properties": {
              "mode": { "enum": ["off", "auto", "force"] },
              "strength": { "type": "number", "minimum": 0, "maximum": 1 },
              "max_crop_percent": { "type": "number", "minimum": 0, "maximum": 15 }
            },
            "additionalProperties": false
          },
          "continuity": {
            "type": "object",
            "required": ["transition", "duration_sec", "match_action"],
            "properties": {
              "transition": { "enum": ["hard_cut", "crossfade", "dip_to_black"] },
              "duration_sec": { "type": "number", "minimum": 0, "maximum": 1.5 },
              "match_action": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "audio": {
            "type": "object",
            "required": ["preserve_original", "normalize_dialogue"],
            "properties": {
              "preserve_original": { "type": "boolean" },
              "normalize_dialogue": { "type": "boolean" },
              "gain_db": { "type": "number", "minimum": -60, "maximum": 12 },
              "mute": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "visual": {
            "type": "object",
            "properties": {
              "exposure_ev": { "type": "number", "minimum": -2, "maximum": 2 },
              "brightness": { "type": "number", "minimum": -0.25, "maximum": 0.25 },
              "contrast": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
              "saturation": { "type": "number", "minimum": 0, "maximum": 2 },
              "gamma": { "type": "number", "minimum": 0.5, "maximum": 2 },
              "speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
              "white_balance": {
                "type": "object",
                "properties": {
                  "red_shift": { "type": "number", "minimum": -0.25, "maximum": 0.25 },
                  "green_shift": { "type": "number", "minimum": -0.25, "maximum": 0.25 },
                  "blue_shift": { "type": "number", "minimum": -0.25, "maximum": 0.25 }
                },
                "additionalProperties": false
              },
              "denoise": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["off", "hqdn3d"] },
                  "luma_spatial": { "type": "number", "minimum": 0, "maximum": 10 },
                  "chroma_spatial": { "type": "number", "minimum": 0, "maximum": 10 },
                  "luma_temporal": { "type": "number", "minimum": 0, "maximum": 15 },
                  "chroma_temporal": { "type": "number", "minimum": 0, "maximum": 15 }
                },
                "additionalProperties": false
              },
              "sharpen": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["off", "unsharp"] },
                  "amount": { "type": "number", "minimum": 0, "maximum": 1.5 }
                },
                "additionalProperties": false
              },
              "reframe": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["off", "crop"] },
                  "width_percent": { "type": "number", "minimum": 50, "maximum": 100 },
                  "height_percent": { "type": "number", "minimum": 50, "maximum": 100 },
                  "x_percent": { "type": "number", "minimum": 0, "maximum": 100 },
                  "y_percent": { "type": "number", "minimum": 0, "maximum": 100 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "music": {
      "type": "object",
      "required": ["status", "tracks", "ducking"],
      "properties": {
        "status": { "enum": ["planned", "audition", "ready", "disabled"] },
        "rights_manifest": { "type": "string", "minLength": 1 },
        "audition_report": { "type": "string", "minLength": 1 },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "start_sec", "end_sec", "gain_db"],
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "exclusiveMinimum": 0 },
              "gain_db": { "type": "number", "minimum": -60, "maximum": 0 },
              "fade_in_sec": { "type": "number", "minimum": 0 },
              "fade_out_sec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "ducking": {
          "type": "object",
          "required": ["enabled", "threshold", "ratio", "attack_ms", "release_ms"],
          "properties": {
            "enabled": { "type": "boolean" },
            "threshold": { "type": "number", "minimum": 0.000976563, "maximum": 1 },
            "ratio": { "type": "number", "minimum": 1, "maximum": 20 },
            "attack_ms": { "type": "integer", "minimum": 1, "maximum": 2000 },
            "release_ms": { "type": "integer", "minimum": 1, "maximum": 9000 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["audition", "ready"] }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["rights_manifest", "audition_report"],
            "properties": {
              "tracks": { "minItems": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "subtitles": {
      "type": "object",
      "$defs": {
        "subtitleEvidenceBinding": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))work/qa/[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["status", "language", "source", "cues", "style"],
      "properties": {
        "status": { "enum": ["planned", "review", "ready", "disabled"] },
        "language": { "type": "string" },
        "source": { "type": "string" },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "object",
          "required": [
            "contract_version",
            "subtitle_payload_sha256",
            "subtitle_style_sha256",
            "verified_cue_set_sha256",
            "readability",
            "layout",
            "visual",
            "human_review",
            "approval"
          ],
          "properties": {
            "contract_version": { "const": "subtitle-ready-evidence-v1" },
            "subtitle_payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "subtitle_style_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verified_cue_set_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "readability": { "$ref": "#/$defs/subtitleEvidenceBinding" },
            "layout": { "$ref": "#/$defs/subtitleEvidenceBinding" },
            "visual": { "$ref": "#/$defs/subtitleEvidenceBinding" },
            "human_review": { "$ref": "#/$defs/subtitleEvidenceBinding" },
            "approval": { "$ref": "#/$defs/subtitleEvidenceBinding" }
          },
          "additionalProperties": false
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_sec", "end_sec", "text"],
            "properties": {
              "cue_id": { "type": "string", "minLength": 1 },
              "segment_id": { "type": "string", "minLength": 1 },
              "chapter_id": { "type": "string", "minLength": 1 },
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "exclusiveMinimum": 0 },
              "text": { "type": "string", "minLength": 1 },
              "review_status": {
                "enum": ["pending", "review_required", "verified", "rejected"]
              },
              "position": { "enum": ["bottom_center", "top_center"] }
            },
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pending", "verified"] }
          },
          "additionalProperties": false
        },
        "style": {
          "type": "object",
          "required": ["max_lines", "safe_margin_percent", "position"],
          "properties": {
            "max_lines": { "type": "integer", "minimum": 1, "maximum": 2 },
            "safe_margin_percent": { "type": "number", "minimum": 0, "maximum": 20 },
            "position": { "enum": ["bottom_center", "top_center"] },
            "font_name": { "type": "string", "minLength": 1 },
            "font_size": { "type": "integer", "minimum": 1 },
            "margin_v": { "type": "integer", "minimum": 0 },
            "outline": { "type": "integer", "minimum": 0 },
            "shadow": { "type": "integer", "minimum": 0 },
            "bold": { "type": "boolean" },
            "max_chars_per_line": { "type": "integer", "minimum": 6, "maximum": 40 },
            "background_opacity_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "background_padding": { "type": "integer", "minimum": 0, "maximum": 30 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["review", "ready"] }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["source_sha256"]
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "ready" }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["coverage", "evidence"],
            "properties": {
              "cues": { "minItems": 1 },
              "coverage": {
                "properties": {
                  "status": { "const": "verified" }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "illustration_motion": {
      "type": "object",
      "required": ["status", "items", "subtitle_safe_zone"],
      "properties": {
        "status": { "enum": ["planned", "ready", "disabled"] },
        "subtitle_safe_zone": { "type": "boolean" },
        "effect_evidence": {
          "type": "object",
          "required": ["contract_version", "effect_payload_sha256", "base_media_sha256", "effect_plan", "render_manifest", "visual_qa", "human_review", "approval"],
          "properties": {
            "contract_version": { "const": "effect-ready-evidence-v1" },
            "effect_payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "base_media_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "effect_plan": { "$ref": "#/$defs/effectEvidenceBinding" },
            "render_manifest": { "$ref": "#/$defs/effectEvidenceBinding" },
            "visual_qa": { "$ref": "#/$defs/effectEvidenceBinding" },
            "human_review": { "$ref": "#/$defs/effectEvidenceBinding" },
            "approval": { "$ref": "#/$defs/effectEvidenceBinding" }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "source", "start_sec", "end_sec", "anchor", "animation"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["illustration", "sticker", "callout", "map", "title_card", "hyperframes"] },
              "source": { "type": "string" },
              "media_kind": { "const": "transparent_video" },
              "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "effect_intent": { "enum": ["impact_hit", "kinetic_explain", "place_reveal", "reaction_burst"] },
              "approval_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "exclusiveMinimum": 0 },
              "anchor": { "enum": ["top_left", "top_right", "center", "bottom_left", "bottom_right", "bottom_center"] },
              "animation": { "enum": ["none", "fade", "slide"] },
              "animation_duration_sec": { "type": "number", "minimum": 0.1, "maximum": 2 },
              "scale_percent": { "type": "number", "minimum": 5, "maximum": 100 },
              "margin_percent": { "type": "number", "minimum": 0, "maximum": 20 }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "type": { "const": "hyperframes" } },
                  "required": ["type"]
                },
                "then": {
                  "required": ["media_kind", "source_sha256", "effect_intent", "approval_sha256"],
                  "properties": {
                    "animation": { "const": "none" },
                    "anchor": { "const": "center" },
                    "scale_percent": { "const": 100 },
                    "margin_percent": { "const": 0 }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
