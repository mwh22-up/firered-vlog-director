{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/subtitle-visual-qa.schema.json",
  "title": "Subtitle Visual QA",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "qa_version",
    "status",
    "machine_status",
    "project_id",
    "scope",
    "cue_count",
    "actual_rendered_cue_count",
    "cue_ids",
    "rendered_cue_ids",
    "missing_cue_ids",
    "unrendered_due_to_scope_cue_ids",
    "bindings",
    "readability_summary",
    "layout_probe_summary",
    "ass_parse_summary",
    "blockers",
    "warnings",
    "cue_evidence",
    "high_risk_review_queue",
    "contact_sheets",
    "human_review",
    "release_ready",
    "limitations",
    "ffmpeg_log_path",
    "report_path"
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "issue": {
      "type": "object",
      "required": [
        "code",
        "subject_id",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "time_sec"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time_sec": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "required": [
        "middle"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/frame"
        },
        "middle": {
          "$ref": "#/$defs/frame"
        },
        "exit": {
          "$ref": "#/$defs/frame"
        }
      },
      "additionalProperties": false
    },
    "sheet": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "cue_ids"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cue_ids": {
          "$ref": "#/$defs/ids"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_type": {
      "const": "subtitle_visual_qa"
    },
    "qa_version": {
      "const": "subtitle-visual-evidence-v1"
    },
    "status": {
      "enum": [
        "review_required",
        "blocked"
      ]
    },
    "machine_status": {
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "all",
        "risk"
      ]
    },
    "cue_count": {
      "type": "integer",
      "minimum": 0
    },
    "actual_rendered_cue_count": {
      "type": "integer",
      "minimum": 0
    },
    "cue_ids": {
      "$ref": "#/$defs/ids"
    },
    "rendered_cue_ids": {
      "$ref": "#/$defs/ids"
    },
    "missing_cue_ids": {
      "$ref": "#/$defs/ids"
    },
    "unrendered_due_to_scope_cue_ids": {
      "$ref": "#/$defs/ids"
    },
    "bindings": {
      "type": "object",
      "required": [
        "preview_manifest_path",
        "preview_manifest_sha256",
        "subtitle_source_path",
        "subtitle_source_sha256",
        "realized_timeline_path",
        "realized_timeline_sha256",
        "enhancement_plan_sha256",
        "readability_qa_sha256",
        "readability_policy_sha256",
        "layout_qa_sha256",
        "ass_bundle_sha256",
        "media_bundle_sha256",
        "base_media_sha256",
        "ffmpeg_executable_sha256",
        "readability_policy_version",
        "layout_probe_version"
      ],
      "properties": {
        "preview_manifest_path": { "$ref": "#/$defs/path" },
        "preview_manifest_sha256": { "$ref": "#/$defs/sha" },
        "subtitle_source_path": { "$ref": "#/$defs/path" },
        "subtitle_source_sha256": { "$ref": "#/$defs/sha" },
        "realized_timeline_path": { "$ref": "#/$defs/path" },
        "realized_timeline_sha256": { "$ref": "#/$defs/sha" },
        "enhancement_plan_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "readability_qa_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "readability_policy_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "layout_qa_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "ass_bundle_sha256": { "$ref": "#/$defs/sha" },
        "media_bundle_sha256": { "$ref": "#/$defs/sha" },
        "base_media_sha256": { "$ref": "#/$defs/sha" },
        "ffmpeg_executable_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "readability_policy_version": {
          "type": ["string", "null"]
        },
        "layout_probe_version": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },    "readability_summary": {
      "type": "object",
      "required": [
        "provided",
        "status",
        "high_risk_cue_count"
      ],
      "properties": {
        "provided": {
          "type": "boolean"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "high_risk_cue_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "layout_probe_summary": {
      "type": "object",
      "required": [
        "provided",
        "status",
        "probe_mode",
        "cue_count"
      ],
      "properties": {
        "provided": {
          "type": "boolean"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "probe_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "cue_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ass_parse_summary": {
      "type": "object",
      "required": [
        "ass_count",
        "passed_count",
        "failed_count"
      ],
      "properties": {
        "ass_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "cue_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cue_id",
          "output_id",
          "ass_sha256",
          "media_sha256",
          "frames"
        ],
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1
          },
          "output_id": {
            "type": "string",
            "minLength": 1
          },
          "ass_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "frames": {
            "$ref": "#/$defs/frames"
          }
        },
        "additionalProperties": false
      }
    },
    "high_risk_review_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cue_id",
          "frames",
          "distinct_frame_count"
        ],
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "allOf": [
              {
                "$ref": "#/$defs/frames"
              },
              {
                "required": [
                  "entry",
                  "middle",
                  "exit"
                ]
              }
            ]
          },
          "distinct_frame_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "additionalProperties": false
      }
    },
    "contact_sheets": {
      "type": "object",
      "required": [
        "two_line",
        "dense_segment",
        "position_change",
        "cut_boundary",
        "ultra_short"
      ],
      "properties": {
        "two_line": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        },
        "dense_segment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        },
        "position_change": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        },
        "cut_boundary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        },
        "ultra_short": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        }
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": [
        "status",
        "approval_path",
        "approval_sha256"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "approval_path": {
          "type": "null"
        },
        "approval_sha256": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "release_ready": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "const": "\u5df2\u751f\u6210\u89c6\u89c9\u5e27\u548c\u5e03\u5c40\u8bc1\u636e\uff0c\u6587\u5b57\u51c6\u786e\u6027\u4ecd\u9700\u4eba\u5de5\u542c\u6821\u3002"
      }
    },
    "ffmpeg_log_path": {
      "$ref": "#/$defs/path"
    },
    "report_path": {
      "$ref": "#/$defs/path"
    }
  },
  "additionalProperties": false
}
