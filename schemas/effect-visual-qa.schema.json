{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/effect-visual-qa.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "edit_plan_version", "edit_plan_sha256", "effect_plan_sha256", "effect_payload_sha256", "render_manifest_sha256", "base_media", "effects", "human_review", "conclusion"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "effect-visual-qa-v1" },
    "status": { "const": "evidence_ready" },
    "project_id": { "type": "string", "minLength": 1 },
    "edit_plan_version": { "type": "integer", "minimum": 1 },
    "edit_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_payload_sha256": { "$ref": "#/$defs/sha" },
    "render_manifest_sha256": { "$ref": "#/$defs/sha" },
    "base_media": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effect_id", "output_sha256", "preview", "frames", "machine_checks"],
        "properties": {
          "effect_id": { "type": "string", "minLength": 1 },
          "output_sha256": { "$ref": "#/$defs/sha" },
          "preview": { "$ref": "#/$defs/binding" },
          "frames": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["role", "path", "sha256"],
              "properties": {
                "role": { "enum": ["entry", "peak", "exit"] },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/sha" }
              },
              "additionalProperties": false
            }
          },
          "machine_checks": {
            "type": "object",
            "required": ["decode", "duration", "geometry", "alpha"],
            "properties": {
              "decode": { "const": "passed" },
              "duration": { "const": "passed" },
              "geometry": { "const": "passed" },
              "alpha": { "const": "passed" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "human_review": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "pending" } },
      "additionalProperties": false
    },
    "conclusion": { "const": "已生成视觉帧和布局证据，效果适配性仍需人工检查。" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
