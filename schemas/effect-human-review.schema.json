{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/effect-human-review.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "reviewer", "reviewed_at", "effect_plan_sha256", "effect_payload_sha256", "render_manifest_sha256", "visual_qa_sha256", "base_media_sha256", "effects", "attestation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "effect-human-review-v1" },
    "status": { "const": "approved" },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "effect_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_payload_sha256": { "$ref": "#/$defs/sha" },
    "render_manifest_sha256": { "$ref": "#/$defs/sha" },
    "visual_qa_sha256": { "$ref": "#/$defs/sha" },
    "base_media_sha256": { "$ref": "#/$defs/sha" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effect_id", "decision", "checks", "intensity_feedback"],
        "properties": {
          "effect_id": { "type": "string", "minLength": 1 },
          "decision": { "const": "accepted" },
          "checks": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["timing", "safe_zones", "visual_fit", "intensity"] }
          },
          "intensity_feedback": { "enum": ["keep", "stronger", "softer"] },
          "notes": { "type": "string", "maxLength": 1000 }
        },
        "additionalProperties": false
      }
    },
    "attestation": { "const": "I reviewed the rendered effect previews against the base edit." }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "additionalProperties": false
}
