{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/vlm-analysis-evidence.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "request_sha256", "media_sha256", "provider", "prompt_sha256", "events", "calibration", "safety"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "vlm-analysis-evidence-v1" },
    "status": { "enum": ["evidence_ready", "provider_unavailable"] },
    "project_id": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/sha" },
    "media_sha256": { "$ref": "#/$defs/sha" },
    "provider": { "type": "object", "required": ["name", "model", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "prompt_sha256": { "$ref": "#/$defs/sha" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "shot_id", "event_type", "description", "confidence"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "shot_id": { "type": "string", "minLength": 1 },
          "event_type": { "enum": ["action", "expression", "reaction", "relationship", "subject", "setting", "other"] },
          "description": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "calibration": {
      "type": "object",
      "required": ["method", "calibrated"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "calibrated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["may_approve_deletion", "may_approve_release"],
      "properties": {
        "may_approve_deletion": { "const": false },
        "may_approve_release": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
