{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/directed-preview-selection.schema.json",
  "title": "Directed preview human selection",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "plan_version", "review_pack_sha256", "selected_label", "selected_candidate_sha256", "preview_media_sha256", "realized_timeline_sha256", "cut_qa_sha256", "checks", "selected_by", "selected_at", "attestation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "directed-preview-selection-v1" },
    "status": { "const": "approved" },
    "project_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "integer", "minimum": 2 },
    "review_pack_sha256": { "$ref": "#/$defs/sha256" },
    "selected_label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "selected_candidate_sha256": { "$ref": "#/$defs/sha256" },
    "preview_media_sha256": { "$ref": "#/$defs/sha256" },
    "realized_timeline_sha256": { "$ref": "#/$defs/sha256" },
    "cut_qa_sha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "object",
      "required": ["preview_playback", "visual_continuity", "speech_completeness", "audio_continuity", "story_coherence"],
      "properties": {
        "preview_playback": { "const": "approved" },
        "visual_continuity": { "const": "approved" },
        "speech_completeness": { "const": "approved" },
        "audio_continuity": { "const": "approved" },
        "story_coherence": { "const": "approved" }
      },
      "additionalProperties": false
    },
    "selected_by": { "type": "string", "minLength": 1 },
    "selected_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "maxLength": 2000 },
    "attestation": { "const": "I watched the selected non-release preview and approve this timeline for source rendering." }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
