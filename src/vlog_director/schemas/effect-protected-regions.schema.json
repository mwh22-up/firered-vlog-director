{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/effect-protected-regions.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "project_id", "base_media_sha256", "provider", "regions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "effect-protected-regions-v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "base_media_sha256": { "$ref": "#/$defs/sha" },
    "provider": {
      "type": "object",
      "required": ["name", "version", "input_media_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "input_media_sha256": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region_id", "region_type", "start_sec", "end_sec", "bbox", "confidence"],
        "properties": {
          "region_id": { "type": "string", "minLength": 1 },
          "region_type": { "enum": ["face", "main_subject"] },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "exclusiveMinimum": 0 },
          "bbox": { "$ref": "#/$defs/bbox" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
