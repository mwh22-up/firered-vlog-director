{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/effect-visual-qa.schema.json",
  "type": "object",
  "required": ["schema_version", "contract_version", "status", "project_id", "edit_plan_version", "edit_plan_sha256", "effect_plan_sha256", "effect_payload_sha256", "render_manifest_sha256", "base_media", "effects", "human_review", "conclusion"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "const": "effect-visual-qa-v1" },
    "status": { "enum": ["evidence_ready", "blocked"] },
    "project_id": { "type": "string", "minLength": 1 },
    "edit_plan_version": { "type": "integer", "minimum": 1 },
    "edit_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_plan_sha256": { "$ref": "#/$defs/sha" },
    "effect_payload_sha256": { "$ref": "#/$defs/sha" },
    "render_manifest_sha256": { "$ref": "#/$defs/sha" },
    "base_media": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effect_id", "output_sha256", "preview", "frames", "machine_checks"],
        "properties": {
          "effect_id": { "type": "string", "minLength": 1 },
          "output_sha256": { "$ref": "#/$defs/sha" },
          "preview": { "$ref": "#/$defs/binding" },
          "frames": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["role", "path", "sha256"],
              "properties": {
                "role": { "enum": ["entry", "peak", "exit"] },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/sha" },
                "alpha_bbox": { "oneOf": [{ "$ref": "#/$defs/bbox" }, { "type": "null" }] },
                "collisions": { "type": "array", "items": { "$ref": "#/$defs/collision" } }
              },
              "additionalProperties": false
            }
          },
          "machine_checks": {
            "type": "object",
            "required": ["decode", "duration", "geometry", "alpha"],
            "properties": {
              "decode": { "const": "passed" },
              "duration": { "const": "passed" },
              "geometry": { "const": "passed" },
              "alpha": { "const": "passed" },
              "protected_regions": { "enum": ["not_provided", "passed", "blocked"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "protected_region_bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "collision_summary": {
      "type": "object",
      "required": ["sample_count", "finding_count", "blocking_count", "warning_count"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 },
        "blocking_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "pending" } },
      "additionalProperties": false
    },
    "conclusion": { "const": "已生成视觉帧和布局证据，效果适配性仍需人工检查。" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "collision": {
      "type": "object",
      "required": ["effect_id", "sample_time_sec", "protected_id", "protected_type", "intersection_area_px", "protected_overlap_ratio", "effect_overlap_ratio", "severity"],
      "properties": {
        "effect_id": { "type": "string", "minLength": 1 },
        "sample_time_sec": { "type": "number", "minimum": 0 },
        "protected_id": { "type": "string", "minLength": 1 },
        "protected_type": { "enum": ["subtitle", "face", "main_subject"] },
        "intersection_area_px": { "type": "integer", "minimum": 1 },
        "protected_overlap_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "effect_overlap_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity": { "enum": ["error", "warning"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
