{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firered.local/schemas/visual-treatment-analysis.schema.json",
  "type": "object",
  "required": ["schema_version", "analysis_version", "project_id", "edit_plan_version", "edit_plan_sha256", "realized_timeline_sha256", "base_media", "ffmpeg_identity", "segments"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "analysis_version": { "const": "visual-segment-analysis-v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "edit_plan_version": { "type": "integer", "minimum": 1 },
    "edit_plan_sha256": { "$ref": "#/$defs/sha" },
    "realized_timeline_sha256": { "$ref": "#/$defs/sha" },
    "base_media": { "$ref": "#/$defs/media" },
    "ffmpeg_identity": { "type": "string", "minLength": 1 },
    "protected_regions": { "$ref": "#/$defs/binding" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "start_sec", "end_sec", "sample_times_sec", "metrics", "protected_regions_available", "warning_codes"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "exclusiveMinimum": 0 },
          "sample_times_sec": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0 } },
          "metrics": {
            "type": "object",
            "required": ["luma_mean", "luma_p05", "luma_p50", "luma_p95", "clipped_black_ratio", "clipped_white_ratio", "contrast_std", "saturation_mean", "rgb_means", "sharpness", "motion", "temporal_noise"],
            "properties": {
              "luma_mean": { "$ref": "#/$defs/unit" },
              "luma_p05": { "$ref": "#/$defs/unit" },
              "luma_p50": { "$ref": "#/$defs/unit" },
              "luma_p95": { "$ref": "#/$defs/unit" },
              "clipped_black_ratio": { "$ref": "#/$defs/unit" },
              "clipped_white_ratio": { "$ref": "#/$defs/unit" },
              "contrast_std": { "$ref": "#/$defs/unit" },
              "saturation_mean": { "$ref": "#/$defs/unit" },
              "rgb_means": {
                "type": "object",
                "required": ["red", "green", "blue"],
                "properties": { "red": { "$ref": "#/$defs/unit" }, "green": { "$ref": "#/$defs/unit" }, "blue": { "$ref": "#/$defs/unit" } },
                "additionalProperties": false
              },
              "sharpness": { "type": "number", "minimum": 0 },
              "motion": { "type": "number", "minimum": 0 },
              "temporal_noise": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "protected_regions_available": { "type": "boolean" },
          "warning_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "pattern": "^work/qa/[A-Za-z0-9][A-Za-z0-9._/-]*$" }, "sha256": { "$ref": "#/$defs/sha" } },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:output|work/proxy)/[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "sha256": { "$ref": "#/$defs/sha" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
